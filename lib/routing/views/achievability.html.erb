<% if present?("target_achievability") -%>
<%
  ach = section("target_achievability")
  bounds = ach["bounds"] || {}
  floors = ach["floors"] || {}
  minimum = ach["min_total_variation_distance"].to_f * 100
  achieved = (section("distribution") || {}).sum { |_, row| row["deviation_pct"].to_f.abs } / 2.0
  at_optimum = (achieved - minimum).abs < 0.05
  unreachable = bounds.reject { |_, b| verdict_status(b["verdict"]) == :good }
-%>
<section id="dostizhimost">
  <h2 class="label">Насколько близко к плану можно подойти</h2>

  <p class="lede">
<% if at_optimum -%>
    Отклонение <b><%= h(num(achieved, 1)) %> п.п.</b> — это минимум: ближе к целевым долям
    на этих данных подойти нельзя.
<% else -%>
    Отклонение <b><%= h(num(achieved, 1)) %> п.п.</b> при минимально возможном
    <b><%= h(num(minimum, 1)) %> п.п.</b>
<% end -%>
<% if floors["rounding_pct"].to_f.positive? -%>
    Из них <%= h(num(floors["rounding_pct"], 1)) %> п.п. — из-за того, что заявка неделима:
    целевая доля от <%= h(num(ach["operations"])) %> заявок даёт дробное число,
    а половину выплаты отправить нельзя.
<% end -%>
<% if floors["exact_pct"] -%>
    Минимум подтверждён полным перебором допустимых раскладок.
<% end -%>
  </p>

  <div class="table-scroll table-tight">
    <table>
      <thead>
        <tr>
          <th>Партнёр</th>
          <th class="num">Цель</th>
          <th class="num">Может взять</th>
          <th>Упирается в</th>
          <th>Вердикт</th>
        </tr>
      </thead>
      <tbody>
<% bounds.each do |id, bound| -%>
<%      status = verdict_status(bound["verdict"]) -%>
        <tr>
          <td class="who"><%= h(id) %></td>
          <td class="num"><%= h(pct(bound["target_pct"])) %></td>
          <td class="num dim"><%= h(num(bound["floor_pct"], 1)) %>–<%= h(num(bound["ceiling_pct"], 1)) %>%</td>
          <td class="dim"><%= h(status == :good ? "—" : bound["binding_limit"]) %></td>
          <td><span class="badge <%= h(status) %>"><%= h(bound["verdict"]) %></span></td>
        </tr>
<% end -%>
      </tbody>
    </table>
  </div>

<% if ach["unroutable"].to_i.positive? -%>
  <p class="lede" style="margin-top:16px">
    Заявок, которые не может взять ни один партнёр: <b><%= h(num(ach["unroutable"])) %></b>.
  </p>
<% end -%>
</section>
<% end -%>
