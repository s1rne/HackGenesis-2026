<%
  outcomes = section("outcomes") || {}
  cascade = section("cascade") || {}

  # Худшее отклонение считается отдельно по количеству и по объёму.
  #
  # Раньше плитка была одна и брала только количество, а «в норме» на ней
  # стояло даже когда отклонение по объёму вдвое превышало порог: сводка
  # успокаивала, а диаграмма ниже говорила обратное.
  #
  # И второе: при ничьей (−5 у одного и +5 у другого) max_by возвращал тот,
  # что встретился в данных первым, поэтому знак выглядел случайным.
  # Теперь рядом со значением стоит имя провайдера — знак стало к чему отнести.
  distribution = section("distribution") || {}
  worst_by = lambda do |field|
    pair = distribution.map { |id, row| [id, row[field].to_f] }
                       .max_by { |_, value| value.abs }
    pair && pair.last.abs.positive? ? pair : nil
  end
  worst_count = worst_by.call("deviation_pct")
  worst_volume = worst_by.call("volume_deviation_pct")
-%>
<section id="svodka">
  <div class="tiles">

    <div class="tile">
      <div class="tile-label">Период</div>
      <div class="tile-value" style="font-size:26px"><%= h(section("period") || "—") %></div>
      <div class="tile-sub">
<% if present?("source", "snapshot_at") -%>
        срез состояния <%= h(section("source", "snapshot_at")) %>
<% else -%>
        прогон очереди выплат
<% end -%>
      </div>
    </div>

    <div class="tile">
      <div class="tile-label">Всего заявок</div>
      <div class="tile-value mono"><%= h(num(total_operations)) %></div>
      <div class="tile-sub">
<% if outcomes.any? -%>
        одобрено <%= h(num(outcomes["approved"])) %> · отказ <%= h(num(outcomes["rejected"])) %> · истекло <%= h(num(outcomes["expired"])) %>
<% else -%>
        решений в выгрузке: <%= h(num(decisions.size)) %>
<% end -%>
      </div>
    </div>

<% unless approval_rate_pct.nil? -%>
    <div class="tile">
      <div class="tile-label">Доля одобренных</div>
      <div class="tile-value mono"><%= h(num(approval_rate_pct, 1)) %><span class="unit">%</span></div>
      <div class="tile-sub"><%= h(num(outcomes["approved"])) %> из <%= h(num(total_operations)) %> заявок</div>
    </div>
<% end -%>

<% if outcomes["avg_latency_sec"] -%>
    <div class="tile">
      <div class="tile-label">Средняя задержка</div>
      <div class="tile-value mono"><%= h(num(outcomes["avg_latency_sec"], 1)) %><span class="unit"> с</span></div>
      <div class="tile-sub">суммарно <%= h(seconds(outcomes["total_latency_sec"])) %></div>
    </div>
<% end -%>

<% if cascade.any? -%>
    <div class="tile">
      <div class="tile-label">Глубина каскада</div>
      <div class="tile-value mono"><%= h(num(cascade["avg_depth"], 2)) %></div>
      <div class="tile-sub">
        максимум <%= h(num(cascade["max_depth"])) %> · с первой попытки <%= h(num(cascade["single_attempt"])) %> ·
        спасено переходом <%= h(num(cascade["rescued_by_cascade"])) %>
      </div>
    </div>

    <div class="tile">
      <div class="tile-label">Fallback</div>
      <div class="tile-value mono"><%= h(num(cascade["fallback_used"])) %></div>
      <div class="tile-sub">уходов на собственного провайдера при пустом пуле</div>
    </div>
<% end -%>

<% if worst_count -%>
    <div class="tile">
      <div class="tile-label">Отклонение по количеству</div>
      <div class="tile-value mono"><%= h(signed(worst_count.last, 1)) %><span class="unit"> п.п.</span></div>
      <div class="tile-sub">
        <span class="badge <%= h(deviation_status(worst_count.last)) %>"><%= h(status_word(deviation_status(worst_count.last))) %></span>
        сильнее всех у <%= h(worst_count.first) %>; порог <%= h(num(options[:drift_pct], 0)) %> п.п.
      </div>
    </div>
<% end -%>
<% if worst_volume -%>
    <div class="tile">
      <div class="tile-label">Отклонение по объёму</div>
      <div class="tile-value mono"><%= h(signed(worst_volume.last, 1)) %><span class="unit"> п.п.</span></div>
      <div class="tile-sub">
        <span class="badge <%= h(deviation_status(worst_volume.last)) %>"><%= h(status_word(deviation_status(worst_volume.last))) %></span>
        сильнее всех у <%= h(worst_volume.first) %>; цель по объёму выведена нами
      </div>
    </div>
<% end -%>

  </div>
</section>
