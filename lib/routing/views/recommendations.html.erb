<% if present?("recommendations_detailed") || present?("recommendations") -%>
<section id="rekomendacii">
  <h2 class="label">Что изменить в настройках</h2>

  <ol class="recs">
<% if present?("recommendations_detailed") -%>
<% section("recommendations_detailed").each_with_index do |rec, index| -%>
    <li class="rec">
      <span class="rec-n"><%= index + 1 %></span>
      <span class="rec-text"><%= h(rec["text"]) %>
<% if rec["parameter"] -%>
        <span class="rec-param"><code><%= h(rec["parameter"]) %></code><%
          if rec.key?("current") %>: <%= h(num(rec["current"], 2)) %> → <%= h(num(rec["suggested"], 2)) %><% end %></span>
<% end -%>
      </span>
    </li>
<% end -%>
<% else -%>
<% section("recommendations").each_with_index do |text, index| -%>
    <li class="rec">
      <span class="rec-n"><%= index + 1 %></span>
      <span class="rec-text"><%= h(text) %></span>
    </li>
<% end -%>
<% end -%>
  </ol>
</section>
<% end -%>
