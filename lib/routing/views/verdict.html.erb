<%
  outcomes = section("outcomes") || {}
  cascade = section("cascade") || {}
-%>
<section class="status status-<%= h(verdict_level) %>" id="status">
  <div class="status-line">
    <h1 class="status-title"><%= h(verdict_headline) %></h1>
  </div>
  <p class="status-facts">
    <b><%= h(num(total_operations)) %></b> заявок<%
      unless outcomes.empty? %> · одобрено <b><%= h(num(outcomes["approved"])) %></b><%
      end %><%
      if outcomes["avg_latency_sec"] %> · средняя задержка <b><%= h(num(outcomes["avg_latency_sec"], 0)) %> с</b><%
      end %><%
      if cascade["avg_depth"] %> · глубина каскада <b><%= h(num(cascade["avg_depth"], 2)) %></b><%
      end %><%
      if cascade["fallback_used"].to_i.positive? %> · на свой гейт <b><%= h(num(cascade["fallback_used"])) %></b><%
      end %>
  </p>

<% unless findings.empty? -%>
  <ul class="findings">
<% findings.each do |item| -%>
    <li class="finding finding-<%= h(item.severity) %>">
      <span class="finding-mark" aria-hidden="true"></span>
      <span class="finding-title"><b><%= h(item.title) %></b> — <%= h(item.detail) %>
        <span class="finding-action"><%= h(item.action) %></span>
      </span>
    </li>
<% end -%>
  </ul>
<% end -%>
</section>
