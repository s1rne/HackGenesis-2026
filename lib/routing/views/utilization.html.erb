<% if present?("projected_daily_utilization") -%>
<%
  rows = section("projected_daily_utilization")
  has_turnover = rows.any? { |_, r| r["turnover_min"] }
-%>
<section class="card" id="limity">
  <div class="card-head">
    <h2>Загрузка дневных лимитов</h2>
    <span class="badge flat">порог тревоги <%= h(num(options[:utilization_alert_pct], 0)) %>%</span>
  </div>
  <p class="card-note">
    Сколько оборота провайдер уже выбрал против дневного лимита и сколько осталось свободного места.
<% if has_turnover -%>
    Засечка на полосе — минимальный дневной оборот по финансовому обязательству: пока полоса её не достигла,
    обязательство не выполнено.
<% end -%>
  </p>

<% unless blank?(section("limits_at_risk")) -%>
<% section("limits_at_risk").each do |risk| -%>
  <div class="alert">
    <span class="badge crit">на пределе</span>
    <span><b><%= h(risk["provider"]) %></b> — узкое место: <%= h(risk["worst"]) %>.
<% (risk["measures"] || {}).each do |measure, value| -%>
      <span class="tag"><%= h(measure) %> <%= h(pct(value)) %></span>
<% end -%>
    </span>
  </div>
<% end -%>
<% end -%>

  <div class="chart-legend">
    <span><i class="swatch"></i>выбранный оборот</span>
<% if has_turnover -%>
    <span><i class="swatch tick"></i>минимальный оборот по обязательству</span>
<% end -%>
  </div>

  <div class="chart">
<% rows.each do |id, row| -%>
<%
    used_pct = row["utilization_pct"].to_f
    status = utilization_status(used_pct)
    limit = row["limit"].to_f
    turnover_pct = (row["turnover_min"] && limit.positive?) ? row["turnover_min"].to_f / limit * 100.0 : nil
-%>
    <div class="bar-row">
      <div class="bar-name"><%= h(id) %><span class="sub">за прогон +<%= h(money(row["added_this_run"])) %></span></div>
      <div class="track">
<% ticks(100.0).each do |tick| -%>
        <i class="gridline" style="left:<%= h(scale(tick, 100.0)) %>%"></i>
<% end -%>
        <div class="fill <%= h(status) %>" style="width:<%= h(scale(used_pct, 100.0)) %>%"></div>
<% if turnover_pct -%>
        <i class="marker" style="left:<%= h(scale(turnover_pct, 100.0)) %>%"></i>
<% end -%>
      </div>
      <div class="bar-values">
        <span class="v"><%= h(pct(used_pct)) %></span>
        <span class="t"><%= h(money(row["used"])) %> из <%= h(money(row["limit"])) %></span>
        <span class="badge <%= h(status) %>"><%= h(status_word(status)) %></span>
      </div>
    </div>
    <div class="bar-row" style="padding-top:0">
      <div></div>
      <div style="grid-column:2 / -1;font-size:14px;color:var(--ink-2)">
        <span class="tag">свободно <%= h(money(row["headroom"])) %></span>
<% if row["turnover_min"] -%>
        <span class="tag">обязательство не менее <%= h(money(row["turnover_min"])) %></span>
<% if row["turnover_min_met"] -%>
        <span class="badge good">обязательство выполнено</span>
<% else -%>
        <span class="badge warn">не добрано <%= h(money(row["turnover_min_gap"])) %></span>
<% end -%>
<% end -%>
      </div>
    </div>
<% end -%>
    <div class="axis">
      <div></div>
      <div class="axis-ticks">
<% ticks(100.0).each do |tick| -%>
        <span style="left:<%= h(scale(tick, 100.0)) %>%"><%= h(num(tick, 0)) %>%</span>
<% end -%>
      </div>
      <div></div>
    </div>
  </div>

<% if present?("provider_performance") -%>
  <h3 style="font-size:16px;margin:26px 0 10px">Успешность и отказы по провайдерам</h3>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Провайдер</th>
        <th class="num">Попыток</th>
        <th class="num">Выбран</th>
        <th class="num">Одобрено</th>
        <th class="num">Отказ</th>
        <th class="num">Истекло</th>
        <th class="num">Отсеян</th>
        <th class="num">Конверсия заявл.</th>
        <th class="num">Конверсия набл.</th>
        <th class="num">Загрузка</th>
        <th class="num">Свободных реквизитов</th>
      </tr>
    </thead>
    <tbody>
<% section("provider_performance").each do |id, row| -%>
      <tr>
        <td><b><%= h(id) %></b></td>
        <td class="num"><%= h(num(row["attempts"])) %></td>
        <td class="num"><%= h(num(row["selected"])) %></td>
        <td class="num"><%= h(num(row["approved"])) %></td>
        <td class="num"><%= h(num(row["declined"])) %></td>
        <td class="num"><%= h(num(row["expired"])) %></td>
        <td class="num"><%= h(num(row["skipped"])) %></td>
        <td class="num"><%= h(row["declared_conversion"] ? pct(row["declared_conversion"].to_f * 100) : "—") %></td>
        <td class="num"><%= h(row["observed_conversion"] ? pct(row["observed_conversion"].to_f * 100) : "—") %></td>
        <td class="num"><%= h(row["load_factor"] ? pct(row["load_factor"].to_f * 100) : "—") %></td>
        <td class="num"><%= h(num(row["available_requisites"])) %></td>
      </tr>
<% end -%>
    </tbody>
  </table>
  </div>
<% end -%>
</section>
<% end -%>
