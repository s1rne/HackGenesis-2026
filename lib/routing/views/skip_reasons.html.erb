<% if present?("skip_reasons") -%>
<%
  reasons = section("skip_reasons").sort_by { |code, count| [-count.to_i, code.to_s] }
  peak = reasons.map { |_, count| count.to_i }.max.to_f
  total = reasons.sum { |_, count| count.to_i }
  has_soft = reasons.any? { |code, _| reason_category(code) != "жёсткое ограничение" }
-%>
<section id="otsev">
  <h2 class="label">Почему партнёров отсеивали — <%= h(num(total)) %> раз</h2>

  <div class="bars">
<% reasons.each do |code, count| -%>
<%    hard = reason_category(code) == "жёсткое ограничение" -%>
    <div class="bar <%= hard ? "bar-hard" : "bar-soft" %>">
      <span class="bar-name"><%= h(reason_text(code)) %></span>
      <span class="bar-track"><i class="bar-fill" style="width:<%= h(((count.to_f / peak) * 100).round(1)) %>%"></i></span>
      <span class="bar-value"><%= h(num(count)) %></span>
    </div>
<% end -%>
  </div>

<% if has_soft -%>
  <p class="bars-legend">
    <span class="legend-hard"><i></i>не имел права взять заявку</span>
    <span class="legend-soft"><i></i>имел право, но уступил</span>
  </p>
<% end -%>
</section>
<% end -%>
