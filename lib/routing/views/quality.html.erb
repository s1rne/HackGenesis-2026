<% if present?("data_quality") -%>
<%
  quality = section("data_quality")
  counts = quality["counts"] || {}
  words = {
    "error" => %w[ошибка ошибки ошибок],
    "warning" => %w[предупреждение предупреждения предупреждений],
    "info" => %w[замечание замечания замечаний]
  }
  order = %w[error warning info]
  summary = counts.sort_by { |severity, _| order.index(severity) || 9 }
                  .map { |severity, count| "#{count} #{plural(count.to_i, *words.fetch(severity, [severity] * 3))}" }
                  .join(", ")
  items = Array(quality["items"])
-%>
<section id="kachestvo">
  <details class="data">
    <summary>Входные данные: <%= h(summary.empty? ? "без замечаний" : summary) %></summary>
    <ul class="data-list">
<% items.each do |item| -%>
      <li>
        <span class="sev <%= h(severity_status(item["severity"])) %>"><%= h(severity_label(item["severity"])) %></span>
        <span><%= h(item["source"]) %><%= blank?(item["field"]) ? "" : " · #{h(item["field"])}" %> — <%= h(item["message"]) %></span>
      </li>
<% end -%>
    </ul>
  </details>
</section>
<% end -%>
