<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Роутинг выплат — прогон<%= section("period") ? " #{h(section("period"))}" : "" %></title>
<style>
<%= render("styles.css") %>
</style>
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <span class="brand-title">Роутинг выплат</span>
    <span class="brand-sub">прогон за <%= h(section("period") || "период не указан") %><%
      if present?("source", "gateway") %> · <%= h(section("source", "gateway")) %><% end %><%
      if present?("source", "merchant") %> · <%= h(section("source", "merchant")) %><% end %></span>
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Переключить светлую и тёмную тему">Тема</button>
  </div>
</header>

<main class="page">
<%= render("verdict") %>
<%= render("partners") %>
<%= render("achievability") %>
<%= render("skip_reasons") %>
<%= render("recommendations") %>
<%= render("decisions") %>
<%= render("quality") %>
</main>

<footer class="footer">
  <span>собрано <%= h(generated_at) %></span>
  <span><%= h(sources.join(" · ")) %></span>
</footer>

<script>
<%= render("script.js") %>
</script>
</body>
</html>
