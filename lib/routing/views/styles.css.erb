/* Отчёт о прогоне роутера.
 *
 * Правила, по которым это собрано:
 *   — данные монохромные, цвет только у статуса. В отчёте про деньги
 *     разноцветные диаграммы читаются как украшение, а не как смысл;
 *   — карточек нет. Разделы отбиты линейкой и воздухом: рамка вокруг всего
 *     подряд уравнивает важное с второстепенным;
 *   — у каждого раздела заголовок-метка, а не абзац-пояснение. Пояснения
 *     живут в README, здесь им нечего делать;
 *   — числа моноширинные и выровнены по разряду.
 *
 * Порог подсветки отклонения: <%= @options[:drift_pct] %> п.п.,
 * порог подсветки загрузки: <%= @options[:utilization_alert_pct] %>%.
 */

:root {
  color-scheme: light;
  --plane: #ffffff;
  --panel: #f7f8f9;
  --ink: #14181c;
  --ink-2: #444d55;
  --muted: #7b848c;
  --rule: #e4e7ea;
  --rule-strong: #cdd3d8;
  --fill: #2b3239;
  --fill-soft: #aeb6bd;
  --track: #edeff1;
  --good: #17803d;
  --warn: #a4600a;
  --crit: #b42318;
  --good-bg: #eaf5ed;
  --warn-bg: #fbf2e3;
  --crit-bg: #fbeceb;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --plane: #101316;
    --panel: #171b1f;
    --ink: #f2f4f6;
    --ink-2: #b6bec5;
    --muted: #838d95;
    --rule: #262c31;
    --rule-strong: #394148;
    --fill: #d5dbe0;
    --fill-soft: #59626a;
    --track: #21262b;
    --good: #58c07f;
    --warn: #d99a3c;
    --crit: #e8756a;
    --good-bg: #14251a;
    --warn-bg: #2a2114;
    --crit-bg: #2a1715;
  }
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --plane: #101316;
  --panel: #171b1f;
  --ink: #f2f4f6;
  --ink-2: #b6bec5;
  --muted: #838d95;
  --rule: #262c31;
  --rule-strong: #394148;
  --fill: #d5dbe0;
  --fill-soft: #59626a;
  --track: #21262b;
  --good: #58c07f;
  --warn: #d99a3c;
  --crit: #e8756a;
  --good-bg: #14251a;
  --warn-bg: #2a2114;
  --crit-bg: #2a1715;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--plane);
  color: var(--ink);
  font: 13px/1.5 ui-sans-serif, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-variant-numeric: tabular-nums;
}

.mono, td.num, th.num, .n {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* --- шапка ---------------------------------------------------------------- */

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--plane);
  border-bottom: 1px solid var(--rule);
}

.topbar-inner {
  max-width: 1120px;
  margin: 0 auto;
  padding: 13px 24px;
  display: flex;
  align-items: baseline;
  gap: 14px;
}

.brand-title {
  font-size: 14px;
  font-weight: 640;
  letter-spacing: -0.01em;
}

.brand-sub {
  font-size: 12px;
  color: var(--muted);
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-toggle {
  flex: 0 0 auto;
  font: inherit;
  font-size: 12px;
  color: var(--ink-2);
  background: transparent;
  border: 1px solid var(--rule-strong);
  border-radius: 4px;
  padding: 3px 9px;
  cursor: pointer;
}

.theme-toggle:hover { color: var(--ink); border-color: var(--ink-2); }
.theme-toggle:focus-visible { outline: 2px solid var(--fill); outline-offset: 2px; }

/* --- страница ------------------------------------------------------------- */

.page {
  max-width: 1120px;
  margin: 0 auto;
  padding: 0 24px 72px;
}

section { padding: 30px 0; border-top: 1px solid var(--rule); }
section:first-child { border-top: 0; }

.label {
  font-size: 11px;
  font-weight: 620;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 16px;
}

/* --- статус --------------------------------------------------------------- */

.status { padding-top: 34px; }

.status-line {
  display: flex;
  align-items: baseline;
  gap: 12px;
  flex-wrap: wrap;
}

.status-title {
  margin: 0;
  font-size: 24px;
  font-weight: 640;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

.status-ok .status-title { color: var(--ink); }
.status-warn .status-title { color: var(--ink); }
.status-error .status-title { color: var(--crit); }

.status-facts {
  margin: 7px 0 0;
  font-size: 13px;
  color: var(--muted);
}

.status-facts b { color: var(--ink-2); font-weight: 600; }

.findings {
  list-style: none;
  margin: 22px 0 0;
  padding: 0;
  display: grid;
  gap: 10px;
  max-width: 92ch;
}

.finding {
  display: grid;
  grid-template-columns: 14px 1fr;
  gap: 10px;
  align-items: start;
}

.finding-mark {
  width: 8px;
  height: 8px;
  margin-top: 6px;
  background: var(--fill-soft);
}

.finding-ok .finding-mark { background: var(--good); border-radius: 50%; }
.finding-warn .finding-mark { background: var(--warn); }
.finding-error .finding-mark { background: var(--crit); transform: rotate(45deg); }

.finding-title { font-size: 14px; color: var(--ink); }
.finding-title b { font-weight: 620; }
.finding-action { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; }

/* --- таблицы -------------------------------------------------------------- */

.table-scroll { overflow-x: auto; }

/* Узкой таблице незачем растягиваться на всю ширину: колонки расползаются,
   и между значением и вердиктом появляется полоса пустоты. */
.table-tight table { width: auto; min-width: min(100%, 640px); }

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

th {
  text-align: left;
  font-weight: 600;
  font-size: 11px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0 12px 8px 0;
  border-bottom: 1px solid var(--rule-strong);
  white-space: nowrap;
}

td {
  padding: 9px 12px 9px 0;
  border-bottom: 1px solid var(--rule);
  vertical-align: middle;
}

th.num, td.num { text-align: right; }

/* Верхняя строка шапки группирует колонки: две «доли» подряд без неё
   читаются как опечатка. */
tr.group th {
  border-bottom: 0;
  padding-bottom: 3px;
  font-size: 10px;
  color: var(--muted);
  font-weight: 500;
  text-align: center;
}

tr.group th[colspan]:not(:empty) { border-bottom: 1px solid var(--rule); }
tr:last-child td { border-bottom: 0; }

.who { font-weight: 600; }
.dim { color: var(--muted); }
.delta-ok { color: var(--ink-2); }
.delta-warn { color: var(--warn); }
.delta-crit { color: var(--crit); }

/* Полоса загрузки внутри ячейки: тонкая, монохромная, без подписи —
   число стоит рядом, дублировать его на полосе незачем. */
.meter {
  display: block;
  width: 96px;
  height: 5px;
  background: var(--track);
  position: relative;
}

.meter i {
  position: absolute;
  inset: 0 auto 0 0;
  background: var(--fill);
}

.meter.hot i { background: var(--crit); }
.meter.near i { background: var(--warn); }

/* --- полосы отсева -------------------------------------------------------- */

.bars { display: grid; gap: 7px; max-width: 760px; }

.bar {
  display: grid;
  grid-template-columns: minmax(160px, 22ch) 1fr 3ch;
  align-items: center;
  gap: 12px;
}

.bar-name { font-size: 13px; color: var(--ink-2); }
/* display:block обязателен: у инлайнового span высота не применяется,
   и полоса схлопывается в линию. */
.bar-track { display: block; height: 8px; background: var(--track); }
.bar-fill { display: block; height: 100%; background: var(--fill); }
.bar-hard .bar-fill { background: var(--fill); }
.bar-soft .bar-fill { background: var(--fill-soft); }
.bar-value { font-size: 13px; text-align: right; color: var(--ink); }

.bars-legend {
  margin: 14px 0 0;
  font-size: 12px;
  color: var(--muted);
  display: flex;
  gap: 16px;
}

.bars-legend i {
  display: inline-block;
  width: 9px;
  height: 9px;
  margin-right: 6px;
  vertical-align: baseline;
}

.legend-hard i { background: var(--fill); }
.legend-soft i { background: var(--fill-soft); }

/* --- достижимость --------------------------------------------------------- */

.lede {
  margin: 0 0 18px;
  font-size: 14px;
  line-height: 1.55;
  color: var(--ink-2);
  max-width: 80ch;
}

.lede b { color: var(--ink); font-weight: 620; }

/* --- рекомендации --------------------------------------------------------- */

.recs { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; max-width: 82ch; }

.rec {
  display: grid;
  grid-template-columns: 22px 1fr;
  gap: 10px;
  font-size: 13px;
  line-height: 1.5;
}

.rec-n { color: var(--muted); font-size: 12px; padding-top: 1px; }
.rec-text { color: var(--ink-2); }
.rec-param {
  display: block;
  margin-top: 3px;
  font-size: 12px;
  color: var(--muted);
}

.rec-param code {
  font: inherit;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  color: var(--ink-2);
}

/* --- решения по заявкам --------------------------------------------------- */

.controls {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.controls input,
.controls select,
.controls button {
  font: inherit;
  font-size: 12px;
  color: var(--ink);
  background: var(--plane);
  border: 1px solid var(--rule-strong);
  border-radius: 4px;
  padding: 5px 9px;
}

.controls input { min-width: 210px; }
.controls button { cursor: pointer; color: var(--ink-2); }
.controls button:hover { color: var(--ink); border-color: var(--ink-2); }
.controls :focus-visible { outline: 2px solid var(--fill); outline-offset: 1px; }
.controls .count { font-size: 12px; color: var(--muted); margin-left: auto; }

tr.op { cursor: pointer; }
tr.op:hover td { background: var(--panel); }
tr.op:focus-visible { outline: 2px solid var(--fill); outline-offset: -2px; }

.chev {
  display: inline-block;
  width: 10px;
  color: var(--muted);
  transition: transform 0.12s ease;
}

tr.op[aria-expanded="true"] .chev { transform: rotate(90deg); }

tr.detail td { background: var(--panel); padding: 0; border-bottom: 1px solid var(--rule); }
.detail-inner { padding: 16px 18px 18px; display: grid; gap: 16px; }
.detail-block h4 {
  margin: 0 0 8px;
  font-size: 11px;
  font-weight: 620;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--muted);
}

.why { font-size: 13px; color: var(--ink-2); }
.why .details { margin-top: 5px; color: var(--muted); }

.steps { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; }
.step { display: inline-flex; align-items: center; gap: 7px; }
.step .n { color: var(--muted); }
.arrow { color: var(--muted); }

.attempts { display: grid; gap: 6px; }

.attempt {
  display: grid;
  grid-template-columns: 26px minmax(120px, max-content) 1fr;
  gap: 10px;
  font-size: 12px;
  padding: 6px 0;
  border-top: 1px solid var(--rule);
}

.attempt:first-child { border-top: 0; }
.attempt .seq { color: var(--muted); }
.attempt .stage { color: var(--muted); margin-left: 6px; }
.attempt.selected .who { color: var(--ink); }
.attempt.skipped .who { color: var(--ink-2); }

.tag {
  display: inline-block;
  font-size: 11px;
  color: var(--muted);
  border: 1px solid var(--rule-strong);
  border-radius: 3px;
  padding: 0 5px;
  margin-left: 6px;
}

/* --- бейджи статуса ------------------------------------------------------- */

.badge {
  display: inline-block;
  font-size: 11px;
  line-height: 18px;
  padding: 0 7px;
  border-radius: 3px;
  white-space: nowrap;
  color: var(--ink-2);
  background: var(--track);
}

.badge.good { color: var(--good); background: var(--good-bg); }
.badge.warn { color: var(--warn); background: var(--warn-bg); }
.badge.crit { color: var(--crit); background: var(--crit-bg); }

/* --- данные --------------------------------------------------------------- */

details.data { font-size: 13px; }
details.data > summary { cursor: pointer; color: var(--ink-2); }
details.data > summary:focus-visible { outline: 2px solid var(--fill); outline-offset: 2px; }
.data-list { margin: 14px 0 0; padding: 0; list-style: none; display: grid; gap: 7px; }
.data-list li { display: grid; grid-template-columns: 64px 1fr; gap: 10px; color: var(--ink-2); }
.data-list .sev { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
.data-list .sev.warn { color: var(--warn); }
.data-list .sev.crit { color: var(--crit); }

/* --- подвал --------------------------------------------------------------- */

.footer {
  max-width: 1120px;
  margin: 0 auto;
  padding: 18px 24px 40px;
  border-top: 1px solid var(--rule);
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 12px;
  color: var(--muted);
}

@media (max-width: 720px) {
  .topbar-inner, .page, .footer { padding-left: 16px; padding-right: 16px; }
  .status-title { font-size: 20px; }
  .bar { grid-template-columns: 1fr; gap: 4px; }
  .bar-value { text-align: left; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; }
}
