#!/usr/bin/env ruby
# frozen_string_literal: true

# Статический HTML-дашборд по результатам роутинга.
#
#   bin/dashboard
#   bin/dashboard --decisions routing_decisions.json --report routing_report.json --out out/dashboard.html
#
# На выход — один самодостаточный файл: стили и скрипты внутри, внешних
# запросов нет, открывается с диска без сети.

# Проверка версии — до require и намеренно старым синтаксисом: библиотека
# использует endless-методы из Ruby 3.0, и на старом интерпретаторе человек
# увидел бы синтаксическую ошибку вместо объяснения.
MINIMUM_RUBY = "3.0.0"
if (RUBY_VERSION.split(".").map(&:to_i) <=> MINIMUM_RUBY.split(".").map(&:to_i)) < 0
  warn "Нужен Ruby #{MINIMUM_RUBY} или новее, запущен #{RUBY_VERSION}."
  exit 3
end

require_relative "../lib/routing/dashboard"

exit(Routing::Dashboard::CLI.new(ARGV).run)
